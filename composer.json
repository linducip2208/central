{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mbg/central-kitchen",
    "type": "project",
    "description": "MBG Central Kitchen - Sistem manajemen operasional dapur produksi program Makan Bergizi Gratis",
    "keywords": ["laravel", "kitchen", "management", "production", "food", "dapur", "masak", "inventory", "procurement", "production", "quality-control"],
    "homepage": "https://mbg.id/central-kitchen",
    "license": "proprietary",
    "support": {
        "docs": "https://docs.mbg.id/central-kitchen",
        "issues": "https://github.com/mbg/central-kitchen/issues",
        "source": "https://github.com/mbg/central-kitchen"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-query-builder": "^6.0",
        "spatie/laravel-activitylog": "^4.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-exif": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.0",
        "phpunit/php-code-coverage": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "@php artisan test",
        "lint": "pint --test",
        "lint-fix": "pint"
    },
    "config": {
        "optimize-autoloader": true,
        "psr-4": false,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "platform-php": "8.3",
        "platform": {
            "php": "8.3"
        }
    }
}