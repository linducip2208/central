APP_NAME="MBG Central Kitchen"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mbg_central_kitchen
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
CACHE_STORE=null
CACHE_PREFIX=mbgck_

QUEUE_CONNECTION=database
QUEUE_DB=1
QUEUE_FAILOVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DATABASE=0

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="MBG Central Kitchen"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mbg-central-kitchen
AWS_USE_PATH_STYLE_ENDPOINT=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="MBG Central Kitchen"

# Inventory
INVENTORY_LOT_METHOD=FEFO
INVENTORY_EXPIRY_ALERT_DAYS=30
INVENTORY_LOW_STOCK_THRESHOLD=10
INVENTORY_AUDIT_LOG_ENABLED=true

# Quality Control
QC_AUTO_APPROVE=false
QC_APPROVAL_WORKFLOW=true

# Production
PRODUCTION_BATCH_ENABLED=true
PRODUCTION_LOT_TRACKING=true

# Distribution
DISTRIBUTION_AUTO_ALLOCATE=true
DISTRIBUTION_ROUTE_OPTIMIZATION=true

# Financial
FINANCIAL_CURRENCY=IDR
FINANCIAL_ROUNDING=2
FINANCIAL_COSTING_METHOD=AVG

# License
LICENSE_ENCRYPTION_KEY=
LICENSE_PROVIDER_URL=https://license.mbg.id/api